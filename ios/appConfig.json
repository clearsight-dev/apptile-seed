\"}},\"__serializedType__\":\"ImmutableRecord\",\"__serializedRef__\":19}},\"__serializedType__\":\"ImmutableRecord\",\"__serializedRef__\":18},\"references\":{\"data\":{},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"ConvertKeysToNumbers\"}},\"__serializedType__\":\"ImmutableRecord\",\"__serializedRef__\":17},\"_modelStyles\":{\"paddingTop\":12,\"paddingRight\":10,\"marginRight\":8,\"marginLeft\":8,\"borderColor\":\"#EEEEEE\",\"paddingLeft\":10,\"paddingBottom\":12,\"backgroundColor\":0},\"_cachedModel\":{\"data\":{\"makeKeyboardAware\":false,\"hidden\":true,\"pluginType\":\"ContainerWidget\",\"pageKey\":\"Product\",\"isTappable\":false,\"detectVisibility\":false,\"keyboardAware\":false,\"hapticMethod\":\"\",\"enableHaptics\":false,\"id\":\"tile9::PRDescWrapper1\",\"namespace\":{\"namespace\":[\"tile9\"],\"pluginId\":\"PRDescWrapper1\"}},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"}},\"__serializedType__\":\"ImmutableRecord\",\"__serializedRef__\":0},\"tile9::richText1\":{\"data\":{\"id\":\"tile9::richText1\",\"type\":\"widget\",\"subtype\":\"RichTextWidget\",\"config\":{\"data\":{\"value\":\"Thank you for choosing Shepherd's Fashions. We are committed to providing an excellent shopping experience. Please take a moment to review the details of our return policy, below.\\n<br><br>\\n<strong>Please note: Customers are responsible for all return shipping fees and any taxes & duties incurred upon return to Canada.</strong>\\n<br><br>\\n<strong>Return Address</strong>\\n<br>\\nAttn: Online Returns<br>\\nShepherd’s Fashions<br>\\n145 Trainyards Drive, Unit 4<br>\\nOttawa, ON Canada<br>\\nK1G 3X8\\n<br><br>\\n<strong>Return Eligibility:</strong>\\n<br>\\nYou have 14 days from the purchase or delivery date, whichever is later, to initiate a return for regular-priced items.\\n<br><br>\\nReturned items must be in their original condition – unworn, unwashed, undamaged, with original tags attached. Include the original packing slip.\\n<br><br>\\nTo initiate a return, please use our <strong>online return portal</strong>.\\n<br><br>\\n<strong>Items Not Eligible for Return/Refund:</strong>\\n<br><br>\\nCertain items cannot be returned or refunded, including undergarments.\\n<br><br>\\n<strong>Sale Items:</strong>\\n<br>\\nAll sale and promotional items are final sale. We cannot offer refunds, exchanges, or credits on discounted items, including BOGO items and those purchased during special sale events.\\n<br><br>\\nAny returned sale/ final items will be donated to a local charity.\\n<br><br>\\n<strong>Refund Method:</strong>\\n<br>\\nRefunds will be processed to the original payment method or, if requested, issued as a Shepherd’s Fashions gift card.\\n<br><br>\\n<strong>Damaged or Defective Items:</strong>\\n<br>\\nIf you receive an item that is damaged or defective, please contact us prior to initiating a return. We are here to assist you in resolving any issues and ensuring your satisfaction.\\n<br><br>\\n<strong>Return Process:</strong>\\n<br>\\nWhile return shipping fees are the responsibility of the customer, all returns must be processed through our RETURN PORTAL. This helps us efficiently manage the return process.\\n<br><br>\\nPlease be aware that you will need to manually ship your parcel back to us. We cannot provide a pre-paid shipping label.  \\n<br><br>\\n<strong>Contact Information:</strong>\\n<br>\\nIf you have any questions or concerns, feel free to connect with us via email at online@shepherdsfashions.com or by calling Customer Service at 613-789-7400 (ext. 214).\\n<br><br>\\nWe appreciate your understanding and cooperation. Your satisfaction is our priority!\",\"style\":{\"data\":{\"h1_typography\":{\"data\":{\"_inherit\":\"typography.heading\"},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"},\"strong_typography\":{\"data\":{\"_inherit\":\"typography.heading\",\"fontSize\":14,\"lineHeight\":21},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"}},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"}},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"},\"layout\":{\"data\":{\"container\":\"tile9::PRDescWrapper1\",\"__flexProperties\":{}},\"__serializedType__\":\"ImmutableRecord\",\"__serializedRef__\":4},\"namespace\":{\"namespace\":[\"tile9\"],\"pluginId\":\"richText1\"},\"analytics\":{\"$jsan\":\"u\"},\"animations\":{\"$jsan\":\"u\"},\"_modelStyles\":{\"h1_typography\":{\"fontFamily\":\"Lato-Bold\",\"fontSize\":18,\"letterSpacing\":1,\"lineHeight\":27,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"strong_typography\":{\"fontFamily\":\"Lato-Bold\",\"fontSize\":14,\"letterSpacing\":1,\"lineHeight\":21,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"typography\":{\"fontFamily\":\"Lato-Regular\",\"fontSize\":14,\"letterSpacing\":0,\"lineHeight\":20,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"backgroundColor\":\"#00000000\",\"body_color\":\"#000000\",\"section_color\":\"#000000\",\"div_color\":\"#000000\",\"span_color\":\"#000000\",\"iframe_color\":\"#000000\",\"h1_color\":\"#000000\",\"h2_color\":\"#000000\",\"h2_typography\":{\"fontFamily\":\"Lato-Regular\",\"fontSize\":16,\"letterSpacing\":1.5,\"lineHeight\":22,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"h3_color\":\"#000000\",\"h3_typography\":{\"fontFamily\":\"Lato-Regular\",\"fontSize\":16,\"letterSpacing\":1.5,\"lineHeight\":22,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"h4_color\":\"#000000\",\"h4_typography\":{\"fontFamily\":\"Lato-Regular\",\"fontSize\":16,\"letterSpacing\":1.5,\"lineHeight\":22,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"h5_color\":\"#000000\",\"h5_typography\":{\"fontFamily\":\"Lato-Regular\",\"fontSize\":16,\"letterSpacing\":1.5,\"lineHeight\":22,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"h6_color\":\"#000000\",\"h6_typography\":{\"fontFamily\":\"Lato-Regular\",\"fontSize\":16,\"letterSpacing\":1.5,\"lineHeight\":22,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"p_color\":\"#000000\",\"strong_color\":\"#000000\",\"em_color\":\"#000000\",\"i_color\":\"#000000\",\"ol_color\":\"#000000\",\"ul_color\":\"#000000\",\"li_color\":\"#000000\",\"a_color\":\"#000000\",\"a_typography\":{\"textDecorationLine\":\"none\"},\"img_color\":\"#000000\",\"figure_color\":\"#000000\",\"b_color\":\"#000000\",\"table_color\":\"#000000\",\"tr_color\":\"#000000\",\"th_color\":\"#000000\",\"thead_color\":\"#000000\",\"tbody_color\":\"#000000\",\"tfoot_color\":\"#000000\",\"td_color\":\"#000000\"},\"_cachedModel\":{\"data\":{\"namespace\":{\"namespace\":[\"tile9\"],\"pluginId\":\"richText1\"},\"value\":\"Thank you for choosing Shepherd's Fashions. We are committed to providing an excellent shopping experience. Please take a moment to review the details of our return policy, below.\\n<br><br>\\n<strong>Please note: Customers are responsible for all return shipping fees and any taxes & duties incurred upon return to Canada.</strong>\\n<br><br>\\n<strong>Return Address</strong>\\n<br>\\nAttn: Online Returns<br>\\nShepherd’s Fashions<br>\\n145 Trainyards Drive, Unit 4<br>\\nOttawa, ON Canada<br>\\nK1G 3X8\\n<br><br>\\n<strong>Return Eligibility:</strong>\\n<br>\\nYou have 14 days from the purchase or delivery date, whichever is later, to initiate a return for regular-priced items.\\n<br><br>\\nReturned items must be in their original condition – unworn, unwashed, undamaged, with original tags attached. Include the original packing slip.\\n<br><br>\\nTo initiate a return, please use our <strong>online return portal</strong>.\\n<br><br>\\n<strong>Items Not Eligible for Return/Refund:</strong>\\n<br><br>\\nCertain items cannot be returned or refunded, including undergarments.\\n<br><br>\\n<strong>Sale Items:</strong>\\n<br>\\nAll sale and promotional items are final sale. We cannot offer refunds, exchanges, or credits on discounted items, including BOGO items and those purchased during special sale events.\\n<br><br>\\nAny returned sale/ final items will be donated to a local charity.\\n<br><br>\\n<strong>Refund Method:</strong>\\n<br>\\nRefunds will be processed to the original payment method or, if requested, issued as a Shepherd’s Fashions gift card.\\n<br><br>\\n<strong>Damaged or Defective Items:</strong>\\n<br>\\nIf you receive an item that is damaged or defective, please contact us prior to initiating a return. We are here to assist you in resolving any issues and ensuring your satisfaction.\\n<br><br>\\n<strong>Return Process:</strong>\\n<br>\\nWhile return shipping fees are the responsibility of the customer, all returns must be processed through our RETURN PORTAL. This helps us efficiently manage the return process.\\n<br><br>\\nPlease be aware that you will need to manually ship your parcel back to us. We cannot provide a pre-paid shipping label.  \\n<br><br>\\n<strong>Contact Information:</strong>\\n<br>\\nIf you have any questions or concerns, feel free to connect with us via email at online@shepherdsfashions.com or by calling Customer Service at 613-789-7400 (ext. 214).\\n<br><br>\\nWe appreciate your understanding and cooperation. Your satisfaction is our priority!\",\"pageKey\":\"Product\",\"pluginType\":\"RichTextWidget\",\"id\":\"tile9::richText1\"},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"}},\"__serializedType__\":\"ImmutableRecord\",\"__serializedRef__\":0},\"tile9::container1img\":{\"data\":{\"id\":\"tile9::container1img\",\"type\":\"widget\",\"subtype\":\"ContainerWidget\",\"config\":{\"data\":{\"isTappable\":false,\"keyboardAware\":false,\"detectVisibility\":false,\"enableHaptics\":false,\"hapticMethod\":\"\",\"style\":{\"data\":{\"marginRight\":\"12\"},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"}},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"},\"layout\":{\"data\":{\"container\":\"tile9::TitleCont1\",\"hidden\":true,\"f