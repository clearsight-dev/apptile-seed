.borderRadius = '50%';\\n    spinner.style.width = '50px';\\n    spinner.style.height = '50px';\\n    spinner.style.animation = 'spin 1s linear infinite'; // Spin animation\\n\\n    // Append spinner to the loader\\n    loader.appendChild(spinner);\\n\\n    // Add the loader to the body\\n    document.body.appendChild(loader);\\n\\n    // Add the CSS for the spin animation (without backticks)\\n    let style = document.createElement('style');\\n    style.innerHTML = \\n        '@keyframes spin { ' +\\n            '0% { transform: rotate(0deg); } ' +\\n            '100% { transform: rotate(360deg); } ' +\\n        '} ';\\n    document.head.appendChild(style);\\n\\n    // Interval to handle modal appearance and hide the loader\\n    let interval = setInterval(() => {\\n        let modal = document.querySelector('.scr-modal');\\n        let triggerElement = document.querySelector('.scr-open-size-chart'); // The button or link to trigger the modal\\n\\n        if (triggerElement) {\\n            triggerElement.click(); // Simulate a click to open the modal\\n        }\\n\\n        if (modal) {\\n            // Hide all elements except the modal\\n            document.querySelectorAll('body > *').forEach((element) => {\\n                if (!modal.contains(element) && element !== modal && !element.classList.contains('scr-close')) {\\n                    element.style.display = 'none';\\n                }\\n            });\\n\\n            // Show the modal\\n            modal.style.display = 'block';\\n\\n            // Ensure scr-close is hidden\\n            let closeButton = document.querySelector('.scr-close');\\n            if (closeButton) {\\n                closeButton.style.display = 'none';\\n            }\\n\\n            // Hide the loader after the modal is shown\\n            loader.style.display = 'none';\\n\\n            clearInterval(interval); // Stop checking once the modal is found\\n        }\\n    }, 100);\\n});\\n`}}\",\"t\",\"tile1\",\"webView1\",