 Orders</strong>\\n<br>\\nAll orders, $50 flat rate shipping\\n<br><br>\\n<h1>Taxes & Duties</h1>\\n<strong>Canadian Orders</strong> – Orders are subject to Federal and Provincial taxes. Taxes will be calculated at checkout based on your shipping address.\\n<br><br>\\n<strong>US and International Orders</strong> – Orders may be subject to import fees/ duties & taxes. Shepherd’s cannot take responsibility for any fees that may be applied to a parcel once it crosses the border.\\n<br><br>\\n<h1>Inquiries</h1>\\n<strong>Phone:</strong> 613-366-2171\\n<br>\\n<strong>Email:</strong> online@shepherdsfashions.com\",\"style\":{\"data\":{\"h1_typography\":{\"data\":{\"_inherit\":\"typography.heading\"},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"},\"strong_typography\":{\"data\":{\"_inherit\":\"typography.heading\",\"fontSize\":14,\"lineHeight\":21},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"}},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"}},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"},\"layout\":{\"data\":{\"container\":\"tile10::PRDescWrapper1\",\"__flexProperties\":{}},\"__serializedType__\":\"ImmutableRecord\",\"__serializedRef__\":4},\"namespace\":{\"namespace\":[\"tile10\"],\"pluginId\":\"richText1\"},\"analytics\":{\"$jsan\":\"u\"},\"animations\":{\"$jsan\":\"u\"},\"_modelStyles\":{\"h1_typography\":{\"fontFamily\":\"Lato-Bold\",\"fontSize\":18,\"letterSpacing\":1,\"lineHeight\":27,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"strong_typography\":{\"fontFamily\":\"Lato-Bold\",\"fontSize\":14,\"letterSpacing\":1,\"lineHeight\":21,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"typography\":{\"fontFamily\":\"Lato-Regular\",\"fontSize\":14,\"letterSpacing\":0,\"lineHeight\":20,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"backgroundColor\":\"#00000000\",\"body_color\":\"#000000\",\"section_color\":\"#000000\",\"div_color\":\"#000000\",\"span_color\":\"#000000\",\"iframe_color\":\"#000000\",\"h1_color\":\"#000000\",\"h2_color\":\"#000000\",\"h2_typography\":{\"fontFamily\":\"Lato-Regular\",\"fontSize\":16,\"letterSpacing\":1.5,\"lineHeight\":22,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"h3_color\":\"#000000\",\"h3_typography\":{\"fontFamily\":\"Lato-Regular\",\"fontSize\":16,\"letterSpacing\":1.5,\"lineHeight\":22,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"h4_color\":\"#000000\",\"h4_typography\":{\"fontFamily\":\"Lato-Regular\",\"fontSize\":16,\"letterSpacing\":1.5,\"lineHeight\":22,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"h5_color\":\"#000000\",\"h5_typography\":{\"fontFamily\":\"Lato-Regular\",\"fontSize\":16,\"letterSpacing\":1.5,\"lineHeight\":22,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"h6_color\":\"#000000\",\"h6_typography\":{\"fontFamily\":\"Lato-Regular\",\"fontSize\":16,\"letterSpacing\":1.5,\"lineHeight\":22,\"textTransform\":\"none\",\"textDecorationLine\":\"none\"},\"p_color\":\"#000000\",\"strong_color\":\"#000000\",\"em_color\":\"#000000\",\"i_color\":\"#000000\",\"ol_color\":\"#000000\",\"ul_color\":\"#000000\",\"li_color\":\"#000000\",\"a_color\":\"#000000\",\"a_typography\":{\"textDecorationLine\":\"none\"},\"img_color\":\"#000000\",\"figure_color\":\"#000000\",\"b_color\":\"#000000\",\"table_color\":\"#000000\",\"tr_color\":\"#000000\",\"th_color\":\"#000000\",\"thead_color\":\"#000000\",\"tbody_color\":\"#000000\",\"tfoot_color\":\"#000000\",\"td_color\":\"#000000\"},\"_cachedModel\":{\"data\":{\"namespace\":{\"namespace\":[\"tile10\"],\"pluginId\":\"richText1\"},\"value\":\"Shepherd's is pleased to ship with Canada Post for Canadian, US and International orders.\\n<br><br>\\n<h1>Shipping Rates (effective January 1, 2024)</h1>\\nAs of January 1, 2024, Shepherd’s is no longer offering UPS as a shipping option. We are pleased to ship with Canada Post to all destinations.\\n<br><br>\\n<strong>Updated shipping thresholds, as of January 2\\n<br><br>Canadian Orders</strong><br>\\nOrders of $99 or more before tax, FREE shipping\\nOrders of $98.99 or less before tax, $15 flat rate shipping\\n<br><br>\\n<strong>US Orders</strong>\\n<br>\\nOrders of $99 USD or more before tax, FREE shipping\\n<br>\\nOrders of $98.99 USD or less before tax, $15 USD flat rate shipping\\n<br><br>\\n<strong>Other International Orders</strong>\\n<br>\\nAll orders, $50 flat rate shipping\\n<br><br>\\n<h1>Taxes & Duties</h1>\\n<strong>Canadian Orders</strong> – Orders are subject to Federal and Provincial taxes. Taxes will be calculated at checkout based on your shipping address.\\n<br><br>\\n<strong>US and International Orders</strong> – Orders may be subject to import fees/ duties & taxes. Shepherd’s cannot take responsibility for any fees that may be applied to a parcel once it crosses the border.\\n<br><br>\\n<h1>Inquiries</h1>\\n<strong>Phone:</strong> 613-366-2171\\n<br>\\n<strong>Email:</strong> online@shepherdsfashions.com\",\"pageKey\":\"Product\",\"pluginType\":\"RichTextWidget\",\"id\":\"tile10::richText1\"},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"}},\"__serializedType__\":\"ImmutableRecord\",\"__serializedRef__\":0},\"tile10::container1img\":{\"data\":{\"id\":\"tile10::container1img\",\"type\":\"widget\",\"subtype\":\"ContainerWidget\",\"config\":{\"data\":{\"isTappable\":false,\"keyboardAware\":false,\"detectVisibility\":false,\"enableHaptics\":false,\"hapticMethod\":\"\",\"style\":{\"data\":{\"marginRight\":\"12\"},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"}},\"__serializedType__\":\"ImmutableMap\",\"__postDeserialize__\":\"\"},\"layout\":{\"data\":{\"container\":\"tile10::TitleCont1\",\"hidden\":true,\"flex\":1,\"flexDirection\":\"column\",\"__flexProperties\":{\"flexDirection\":\"column\"}},\"__serializedType__\":\"ImmutableRecord\",\"__serializedRef__\":4},\"namespace\":{\"namespace\":[\"tile10\"],\"pluginId\":\"contai