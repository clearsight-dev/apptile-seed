+    // Auto-enter PiP (API 31+, Home/gesture) never goes through enterPictureInPictureMode(), so the
+    // aspect ratio has to be on the params before the user leaves, or Android opens its default
+    // landscape window. Same approach as v7's PictureInPictureUtils.createPictureInPictureParams.
+    @JvmStatic
+    fun applyAspectRatio(context: ThemedReactContext, pipParamsBuilder: PictureInPictureParams.Builder?, player: ExoPlayer?, playerView: View?) {
+        if (pipParamsBuilder == null || Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+        val aspectRatio = calcAutoEnterAspectRatio(player, playerView) ?: return
+        pipParamsBuilder.setAspectRatio(aspectRatio)
+        updatePictureInPictureActions(context, pipParamsBuilder.build())
+    }
+
+    // Video format first (rotation-aware); the player view's own shape until the video has loaded.
+    private fun calcAutoEnterAspectRatio(player: ExoPlayer?, playerView: View?): Rational? {
+        val videoFormat = player?.videoFormat
+        val width: Int
+        val height: Int
+        if (videoFormat != null && videoFormat.width > 0 && videoFormat.height > 0) {
+            val isRotated = videoFormat.rotationDegrees == 90 || videoFormat.rotationDegrees == 270
+            width = if (isRotated) videoFormat.height else videoFormat.width
+            height = if (isRotated) videoFormat.width else videoFormat.height
+        } else if (playerView != null && playerView.width > 0 && playerView.height > 0) {
+            width = playerView.width
+            height = playerView.height
+        } else {
+            return null
+        }
+        val aspectRatio = Rational(width, height)
+        val maximumRatio = Rational(239, 100)
+        val minimumRatio = Rational(100, 239)
+        return when {
+            aspectRatio.toFloat() > maximumRatio.toFloat() -> maximumRatio
+            aspectRatio.toFloat() < minimumRatio.toFloat() -> minimumRatio
+            else -> aspectRatio
+        }
+    }
